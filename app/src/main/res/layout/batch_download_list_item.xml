<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="?attr/selectableItemBackground">

    <!-- Selection checkbox -->
    <CheckBox
        android:id="@+id/batch_dl_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:checked="true"
        android:focusable="false" />

    <!-- Thumbnail -->
    <ImageView
        android:id="@+id/batch_dl_thumbnail"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerCrop"
        android:background="?attr/card_background"
        android:contentDescription="@null" />

    <!-- Info Area (Title + Score + Type + Subreddit) -->
    <LinearLayout
        android:id="@+id/batch_dl_info_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/batch_dl_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="?attr/fontColor"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/batch_dl_score_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_arrow_upward"
                android:alpha="0.6"
                android:tint="?attr/fontColor"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/batch_dl_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="?attr/fontColor"
                android:textSize="12sp"
                android:alpha="0.6" />

            <TextView
                android:id="@+id/batch_dl_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="?attr/fontColor"
                android:textSize="12sp"
                android:alpha="0.6" />

            <TextView
                android:id="@+id/batch_dl_subreddit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="?attr/fontColor"
                android:textSize="12sp"
                android:alpha="0.6"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/batch_dl_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="middle"
            android:textColor="?attr/fontColor"
            android:textSize="11sp"
            android:alpha="0.4" />

    </LinearLayout>

    <!-- Error icon — shown only when download failed (Phase 4) -->
    <ImageView
        android:id="@+id/batch_dl_error_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_report"
        android:contentDescription="@string/batch_dl_item_failed"
        android:visibility="gone" />

</LinearLayout>
