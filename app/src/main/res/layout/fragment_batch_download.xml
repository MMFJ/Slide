<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/activity_background">

    <!-- State 1: IDLE — tappable prompt -->
    <LinearLayout
        android:id="@+id/batch_dl_prompt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/batch_dl_prompt_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/batch_dl_tap_prompt"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textColor="?attr/fontColor"
            android:gravity="center"
            android:padding="16dp" />

    </LinearLayout>

    <!-- State 2: LOADING — spinner + counter (hidden initially) -->
    <LinearLayout
        android:id="@+id/batch_dl_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/batch_dl_loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/batch_dl_fetching"
            android:textColor="?attr/fontColor" />

    </LinearLayout>

    <!-- State 3: READY — media list (hidden initially) -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/batch_dl_swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/batch_dl_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="64dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Action bar — pinned to bottom (hidden initially) -->
    <LinearLayout
        android:id="@+id/batch_dl_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/card_background"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone">

        <!-- Triple-dots button on the far left -->
        <ImageButton
            android:id="@+id/batch_dl_mark_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/batch_dl_mark_downloads"
            android:src="@drawable/ic_more_vert"
            android:tint="?attr/fontColor" />

        <!-- Type filter button -->
        <Button
            android:id="@+id/batch_dl_type_btn"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/batch_dl_type_filter"
            android:textColor="?attr/fontColor" />

        <!-- Load more button -->
        <Button
            android:id="@+id/batch_dl_load_more"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Load 4 pages ↓"
            android:textColor="?attr/fontColor"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <!-- Select All icon button -->
        <ImageButton
            android:id="@+id/batch_dl_select_all"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/batch_dl_select_all"
            android:src="@drawable/ic_done_all"
            android:tint="?attr/fontColor" />

        <!-- Download progress text (visible during download) -->
        <TextView
            android:id="@+id/batch_dl_download_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"
            android:textColor="?attr/fontColor"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Download icon button -->
        <ImageButton
            android:id="@+id/batch_dl_download"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/batch_dl_download"
            android:src="@drawable/ic_download"
            android:tint="?attr/fontColor" />

    </LinearLayout>

</FrameLayout>
